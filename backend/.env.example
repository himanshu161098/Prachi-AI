# ==============================================================================
# PRACHI AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
PORT=3001
NODE_ENV=production
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-characters
JWT_EXPIRES_IN=7d

# Transactional Email Provider
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_transactional_email_api_key_here
EMAIL_FROM=noreply@prachi.ai
EMAIL_FROM_NAME=Prachi AI Security

# SMTP Settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email@gmail.com
SMTP_PASS=your_smtp_app_password_or_token

# SMS Gateway (Optional)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OTP Security Policies
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting
RATE_LIMIT_MAX=300

# Default AI Provider & Models
DEFAULT_AI_PROVIDER=openai
DEFAULT_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Demo Flags
ENABLE_DEMO_ACCOUNT=true
ALLOW_DEV_OTP=false
